# Copy this file to .env and fill in real values.
# docker-compose and the Blazor app pick these up at runtime.
# .env is gitignored so your real keys never land in a commit.

# Postgres password used by both the postgres container and the webapp
# connection string.
POSTGRES_PASSWORD=change-me

# AssemblyAI API key (used by AssemblyAITranscriptionService)
ASSEMBLYAI_API_KEY=

# Google Gemini API key (used by GeminiExtractionService / GeminiDiseaseSearchService)
GEMINI_API_KEY=
